.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---- evaluation report (standalone artifact, not part of codebase) ----
EVAL-REPORT.md

# ---- env / secrets ----
.env
.env.local
.env.*.local

# ---- logs / pids ----
logs/
*.log
*.pid
*.seed
*.pid.lock
